// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum TourType {
  DOMESTIC
  INTERNATIONAL
}

enum TourStatus {
  DRAFT
  PUBLISHED
  PAUSED
  ARCHIVED
}

model Tour {
  id               String     @id
  code             String     @unique
  name             String
  slug             String     @unique
  shortDescription String?
  description      String?
  categoryId       String?
  type             TourType
  durationDays     Int
  durationNights   Int
  status           TourStatus @default(DRAFT)
  createdAt        DateTime
  updatedAt        DateTime
  publishedAt      DateTime?

  @@map("tours")
}
